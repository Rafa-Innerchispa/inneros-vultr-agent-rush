# For local demo ONLY. Never expose public demo without rate limiting & reverse proxy.
PUBLIC_DEMO=1
DB_PATH=./data/inneros_agent_rush.sqlite
# Set AUTH_TOKEN and PUBLIC_DEMO=0 for protected deployments.
AUTH_TOKEN=
# Optional local-first model. No model is called unless both fields configured.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
SANDBOX_IMAGE=python:3.12-alpine

# Optional: isolated runner VM reachable ONLY over Vultr private network.
SANDBOX_RUNNER_URL=
RUNNER_TOKEN=
